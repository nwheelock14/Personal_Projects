#include "LCD.h"

void Command(uint8_t data_bits)
{
//	void command(char i)
//	{
//	 P1 = i; //put data on output Port
//	 D_I =0; //D/I=LOW : send instruction
//	 R_W =0; //R/W=LOW : Write
//	 E = 1;
//	 Delay(1); //enable pulse width >= 300ns
//	 E = 0; //Clock enable: falling edge
//	}

	GPIOC->ODR = (GPIOC->ODR & 0xFFFFFF00) | data_bits;
	HAL_GPIO_WritePin(GPIOA, Register_Select_Pin, GPIO_PIN_RESET); // Sets RS to 0 for command
	HAL_GPIO_WritePin(GPIOC, RW_Select_Pin, GPIO_PIN_RESET); // Sets RW to 0 for write
	HAL_GPIO_WritePin(GPIOA, LCD_Enable_Pin, GPIO_PIN_SET);
	HAL_Delay(1);
	HAL_GPIO_WritePin(GPIOA, LCD_Enable_Pin, GPIO_PIN_RESET);

}

void Write_Data(uint8_t data_bits)
{
//	void write(char i)
//	{
//	 P1 = i; //put data on output Port
//	 D_I =1; //D/I=HIGH : send data
//	 R_W =0; //R/W=LOW : Write
//	 E = 1;
//	 Delay(1); //enable pulse width >= 300ns
//	 E = 0; //Clock enable: falling edge
//	}

	GPIOC->ODR = (GPIOC->ODR & 0xFFFFFF00) | data_bits;
	HAL_GPIO_WritePin(GPIOA, Register_Select_Pin, GPIO_PIN_SET); // Sets RS to 1 for data
	HAL_GPIO_WritePin(GPIOC, RW_Select_Pin, GPIO_PIN_RESET); // Sets RW to 0 for write
	HAL_GPIO_WritePin(GPIOA, LCD_Enable_Pin, GPIO_PIN_SET);
	HAL_Delay(1);
	HAL_GPIO_WritePin(GPIOA, LCD_Enable_Pin, GPIO_PIN_RESET);
}

